{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automation Workflow v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "target",
    "steps"
  ],
  "properties": {
    "version": {
      "const": 2
    },
    "target": {
      "type": "string",
      "pattern": "^(web|api):[a-zA-Z0-9_-]{1,64}$"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "target"
        ],
        "properties": {
          "op": {
            "enum": [
              "navigate",
              "fill",
              "click",
              "check",
              "select",
              "assertText",
              "assertVisible",
              "assertCount",
              "request",
              "assertStatus",
              "assertJson",
              "assertBody"
            ]
          },
          "target": {
            "type": "string",
            "maxLength": 500
          },
          "value": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 16000
          }
        }
      },
      "contains": {
        "properties": {
          "op": {
            "enum": [
              "assertText",
              "assertVisible",
              "assertCount",
              "assertStatus",
              "assertJson",
              "assertBody"
            ]
          }
        },
        "required": [
          "op"
        ]
      }
    }
  }
}
